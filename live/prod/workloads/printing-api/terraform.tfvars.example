aws_region = "ap-northeast-1"

cluster_arn = "arn:aws:ecs:ap-northeast-1:555555555555:cluster/printing-prod"
subnet_ids = [
  "subnet-0123456789abcdef0",
  "subnet-0fedcba9876543210"
]
security_group_ids = [
  "sg-0123456789abcdef0"
]
target_group_arn = "arn:aws:elasticloadbalancing:ap-northeast-1:555555555555:targetgroup/printing-api/0123456789abcdef"

# Pin to an immutable digest in production.
container_image = "555555555555.dkr.ecr.ap-northeast-1.amazonaws.com/printing-api@sha256:replace-me"
desired_count   = 2

cost_centre         = "PRINT-PLATFORM"
data_classification = "Confidential"
